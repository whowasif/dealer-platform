# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# PostgreSQL connection string for the dealer_platform database.
# Local dev:       postgresql://postgres:PASSWORD@localhost:5433/dealer_platform
# Server (cPanel): postgresql://mis_solution_user:mis_solution_user_p@ss@localhost:5432/dealer_platform
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5433/dealer_platform

# Secret used to sign JWT session tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Session lifetime in seconds (default 8 hours).
SESSION_MAX_AGE=28800

# Base directory for uploaded document files. Keep this OUTSIDE the project.
# Files are served only via the authenticated /documents/[id]/file route.
# Default (Windows): D:\Office\database files
UPLOAD_DIR=D:\Office\database files

# Origin of the public marketing website (no trailing slash).
# Local dev:   http://localhost:3001
# Production:  https://network.missolution.com.bd
NEXT_PUBLIC_WEBSITE_ORIGIN=http://localhost:3001
