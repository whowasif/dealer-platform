# PostgreSQL connection string for the EXISTING dealer_platform database.
# The schema and seed data are already loaded. Replace PASSWORD with your
# actual local postgres password. Database runs on port 5433.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5433/dealer_platform

# Secret used to sign JWT session tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Optional: session lifetime in seconds (default 8 hours)
SESSION_MAX_AGE=28800

# Base directory for uploaded document files (Task 8 — Document Management).
# Files are written to local disk under {UPLOAD_DIR}/{yyyy}/{mm}/{uuid}-{name}.
# Keep this OUTSIDE the project (and out of version control) — files are served
# only via the authenticated /documents/[id]/file route, never statically.
# The DB stores a RELATIVE storage key so this base can change without a
# migration. A cloud backend can replace lib/storage.ts without touching feature
# code. Default (Windows): D:\Office\database files
UPLOAD_DIR=D:\Office\database files
