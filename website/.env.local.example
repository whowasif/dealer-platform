# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and never committed.

# PostgreSQL connection string — shared dealer_platform database.
# Local dev:      postgresql://postgres:YOUR_PASSWORD@localhost:5433/dealer_platform
# Server (cPanel): postgresql://mis_solution_user:mis_solution_user_p@ss@localhost:5432/dealer_platform
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/dealer_platform

# MapTiler API key for the 3D location map on the contact section.
# Get a free key at https://www.maptiler.com/
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
